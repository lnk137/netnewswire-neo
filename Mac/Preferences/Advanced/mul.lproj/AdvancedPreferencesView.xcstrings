    "fOZ-zv-QTc.title": {
      "comment": "Class = \"NSTextFieldCell\"; title = \"If you’re not sure, choose Release builds. Test builds may have bugs, which may include crashing bugs and data loss.\"; ObjectID = \"fOZ-zv-QTc\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "If you’re not sure, choose Release builds. Test builds may have bugs, which may include crashing bugs and data loss."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no estás seguro, elige Versiones finales. Las versiones de prueba pueden tener errores, incluidos fallos y pérdida de datos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果不确定，请选择发布版本。测试版本可能存在错误，包括导致崩溃的错误和数据丢失。"
          }
        }
      }
    },
